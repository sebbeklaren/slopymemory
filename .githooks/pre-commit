#!/usr/bin/env bash
# Before a commit exists: the author email must not be a private mailbox, and the staged files must carry no secret,
# home path, private mailbox or build-record jargon. The same scanner CI runs.
# Enable once per clone: git config core.hooksPath .githooks
# A maintainer's further checks run after it when `git config slopymem.extraScan` names a command; it gets the same
# arguments as the scanner (`.` and the staged files). Unset, nothing else runs.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/public_scan_ci.py --author "$(git config user.email || true)"
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM)
[ ${#files[@]} -eq 0 ] && exit 0
python3 scripts/public_scan_ci.py . "${files[@]}"
extra="$(git config --get slopymem.extraScan || true)"
if [ -n "$extra" ]; then eval "$extra" '.' '"${files[@]}"'; fi
